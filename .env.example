# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI
GEMINI_API_KEY=
# Optional. Leave blank to let the server try gemini-3.5-flash-lite ->
# gemini-3.6-flash -> gemini-2.5-flash-lite and keep the first one that answers.
# Set this only to pin a specific model; a wrong value disables AI recommendations.
GEMINI_MODEL=

# Secondary AI provider. Used automatically when every Gemini model fails, so a
# provider outage does not drop recommendations to the static fallback (which
# converts far worse on affiliate links).
OPENAI_API_KEY=
OPENAI_MODEL=
# Provider priority. Default is "gemini,openai".
AI_PROVIDER_ORDER=

# Legacy product price lookup - server only.
# NAVER Shopping Search is scheduled to end on 2026-07-31; do not create a new dependency on it.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Optional nearby restaurant ratings/review counts - server only.
# Google Places rating/review fields are billable. Leave blank until billing is approved.
GOOGLE_PLACES_API_KEY=
# Optional Google Weather API key. This API must be enabled separately and can be billable.
# Leave blank to disable weather-aware recommendation context.
GOOGLE_WEATHER_API_KEY=

# Coupang Partners API - server only. Never prefix secrets with NEXT_PUBLIC_.
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_SUB_ID=choiceflow
# Protects POST /api/coupang/health. Use a long random server-only value.
COUPANG_DIAGNOSTIC_TOKEN=

# PortOne
PORTONE_API_SECRET=

# Push notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Scheduled/server jobs
CRON_SECRET=

# Consultation notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NEXT_PUBLIC_EXPERT_GOOGLE_FORM_URL=
